# Caddyfile configuration for Nisol AI AWS VM
{
    email superadmin@nisolai.com
}

# 1. Main Nisol AI Application & ConductOS Portal
app.nisolai.com, conductos.nisolai.com {
    reverse_proxy nisol-app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 2. RoOption Institutional Algorithmic Trading Platform
rooption.nisolai.com {
    # WebSocket and API routes to RoOption backend
    reverse_proxy /ws/* nisol-rooption-backend:5900
    reverse_proxy /api/* nisol-rooption-backend:5900 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    reverse_proxy /docs* nisol-rooption-backend:5900
    reverse_proxy /openapi.json nisol-rooption-backend:5900

    # Frontend UI
    reverse_proxy * nisol-rooption-frontend:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

app.rooption.nisolai.com {
    reverse_proxy /ws/* nisol-rooption-backend:5900
    reverse_proxy * nisol-rooption-backend:5900 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 3. Centralized LLM Observability Console (Langfuse)
langfuse.nisolai.com {
    reverse_proxy nisol-langfuse:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 4. Social Media Scheduler (TryPost)
social.nisolai.com, trypost.nisolai.com, post.nisolai.com {
    reverse_proxy nisol-trypost:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
