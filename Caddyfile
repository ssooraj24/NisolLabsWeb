# Caddyfile configuration for Nisol AI AWS VM
{
    email admin@nisolai.com
}

# Main Application & API Portal
app.nisolai.com {
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Centralized LLM Observability Console
langfuse.nisolai.com {
    reverse_proxy langfuse:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

